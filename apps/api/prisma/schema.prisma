generator client {
  provider = "prisma-client-js"
  /**
   * La cible est nommée, pas devinée.
   *
   * `native` seul demande le moteur de la machine qui **génère**. En image
   * multi-étapes, cela suffisait tant que génération et exécution partageaient
   * la même base ; le jour où ce n'est plus vrai, le conteneur démarre, ne
   * trouve pas `libquery_engine-…so.node`, et redémarre en boucle — c'est
   * arrivé en production, jeu à l'arrêt.
   *
   * `debian-openssl-3.0.x` est la cible de `node:22-bookworm-slim`, l'image
   * d'exécution. On la nomme donc explicitement, en plus de `native` qui sert
   * aux postes de développement.
   */
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Specialization {
  CEREALIER
  ELEVEUR
  ETA
}

enum CropCode {
  WHEAT
  MAIZE
  PEA
  BARLEY
  RAPE
  GRASS
}

enum FieldStage {
  EMPTY
  PREPARED
  PLANTED
  GROWING
  READY
  /// Laissée trop longtemps sur pied : plus rien à récolter, labour requis
  SPOILED
  HARVESTED
}

enum ContractJobType {
  PLOW
  SOW
  FERTILIZE
  HARVEST
  TRANSPORT
}

enum ContractStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum BuildingType {
  SILO
  HAY_BARN
  MACHINE_SHED
  CATTLE_BARN
  PIGSTY
  HENHOUSE
  SHEEPFOLD
  WORKSHOP
  FARMHOUSE
  PADDOCK
  PIG_YARD
  HEN_YARD
  COLD_ROOM
  BUNKER_SILO
  /// Petits ouvrages : ils ne stockent rien, ils branchent un système sur un
  /// autre. Voir `BUILDING_DEFS` côté domaine.
  SOLAR_PANELS
  WIND_TURBINE
  BEEHIVE
  /// Ateliers de transformation : ils consomment une marchandise et en rendent
  /// une autre, plus chère. Voir `RECIPES` côté domaine.
  DAIRY
  MILL
  /// Annexes d'élevage : collées à un abri, elles ne changent rien à ce qu'il
  /// héberge mais font monter son niveau d'installation, et avec lui la
  /// production, la reproduction et l'économie de fourrage.
  WATER_TROUGH
  HAY_RACK
}

enum CellKind {
  EMPTY
  CROP
  BUILDING
  VEHICLE
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  displayName    String
  specialization Specialization
  level          Int            @default(1)
  xp             Int            @default(0)
  crd            Float          @default(12000)
  /// Empreinte bcrypt du code d'accès — plus jamais le code lui-même.
  ///
  /// Il y a été stocké **en clair** sous un commentaire qui l'assumait
  /// (« pas un vrai hash — démo locale ») : la démo est devenue un jeu
  /// public, le commentaire n'a pas bougé, et le mot de passe d'un joueur a
  /// fini par se lire dans cette colonne.
  ///
  /// La colonne accepte les deux formes le temps de la migration :
  /// `codeCorrespond()` reconnaît une empreinte (`$2b$…`) d'un code en clair
  /// et vérifie l'une ou l'autre. Un compte encore en clair bascule à sa
  /// première connexion réussie ; `scripts/farmsim-hacher-codes.mjs` balaie
  /// ceux qui ne reviennent pas. Personne n'est invalidé dans un cas comme
  /// dans l'autre.
  ///
  /// Chaîne vide = compte qui ne peut pas se connecter, c'est le cas des PNJ.
  ///
  /// Le défaut reste « ferme » en clair, et il le faut : une valeur par
  /// défaut ne peut pas être calculée par la base. Les deux routes qui créent
  /// un compte fournissent toujours l'empreinte, ce défaut ne sert donc
  /// qu'aux lignes posées à la main.
  accessCode     String         @default("ferme")
  /// Empreinte du code de secours (SHA-256 salé par l'id), jamais le code.
  /// Nul tant que le compte n'en a pas reçu : les comptes créés avant que le
  /// mécanisme existe s'en voient remettre un à leur prochaine connexion.
  recoveryHash   String?
  /// Date du dernier code de secours remis. Sert à dire au joueur depuis
  /// quand celui qu'il a noté est valable.
  recoveryAt     DateTime?
  lastSeenAt     DateTime?
  lastMarketJson String?
  /** Indices du créateur de perso (peau, chapeau, vêtements…) */
  appearanceJson String?
  /// Compteurs cumulés de travail — cases semées, tonnes récoltées, bêtes
  /// soignées. Les quêtes s'en déduisent au lieu d'entretenir un avancement
  /// séparé, qui finirait par diverger. Une colonne JSON plutôt que quinze
  /// colonnes entières : le jeu de compteurs bougera encore.
  statsJson      String         @default("{}")
  lastParcelId   String?
  lastCellX      Int?
  lastCellY      Int?
  isNpc          Boolean        @default(false)
  consignesJson  String?
  absenceLogJson String?
  createdAt      DateTime       @default(now())
  farm           Farm?
  contracts      NpcContract[]  @relation("Provider")
  laborPosted    LaborOrder[]   @relation("LaborClient")
  laborTaken     LaborOrder[]   @relation("LaborProvider")
  sessions       Session[]
  listings       MarketListing[] @relation("Selling")
  futures        FuturesContract[] @relation("Futures")
  purchases      MarketListing[] @relation("Buying")
  machinesListed MachineListing[] @relation("SellingMachines")
  machinesBought MachineListing[] @relation("BuyingMachines")
  deliveriesSold   Delivery[] @relation("DeliverySeller")
  deliveriesBought Delivery[] @relation("DeliveryBuyer")
  questClaims      QuestClaim[]
  ledger         LedgerEntry[]
}

/// Récompense de quête déjà encaissée. Seul l'encaissement se stocke :
/// l'avancement, lui, se lit sur les compteurs, donc il ne peut pas mentir.
model QuestClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String
  claimedAt DateTime @default(now())

  @@unique([userId, questId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Farm {
  id         String          @id @default(cuid())
  userId     String          @unique
  user       User            @relation(fields: [userId], references: [id])
  name       String
  parcels    Parcel[]
  inventory  InventoryItem[]
  machines   Machine[]
  herds      Herd[]
  supplies   SupplyOrder[]
  /**
   * Gazole en cuve, en litres.
   *
   * Une seule jauge pour toute la ferme : les chantiers y puisent. Un
   * réservoir par engin aurait ajouté un « faire le plein » par machine et par
   * chantier, sans ajouter la moindre décision.
   */
  fuelL      Float           @default(1200)
  /** Solde dû à la banque. Les intérêts courent dessus, chaque jour. */
  debtCrd    Float           @default(0)
  /** Dernière écriture d'intérêts — sert de point de départ au calcul. */
  debtAt     DateTime?
}

/**
 * Une commande passée au négociant, en route vers la ferme.
 *
 * L'achat versait la marchandise au silo dans la même milliseconde : on
 * cliquait, un chiffre changeait quelque part, et rien ne se passait à
 * l'écran. Une ferme reçoit pourtant ses intrants — un camion arrive, on
 * décharge, on range. Ce temps-là existe maintenant : quelques secondes de
 * route, une caisse posée dans la cour, et un geste pour la rentrer.
 *
 * Le nom : `Delivery` désignait déjà la livraison d'une vente entre joueurs.
 * Une commande au négociant est autre chose — un intrant qu'on fait venir.
 *
 * La marchandise n'est **pas** au stock tant que la caisse n'est pas rentrée :
 * c'est ce qui donne son poids au geste. Elle n'est jamais perdue pour autant
 * — passé `autoAt`, le premier tick la range tout seul, et le joueur qui
 * ferme l'onglet retrouve son achat.
 */
model SupplyOrder {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  /** Denrée commandée, code `TradeGood`. */
  commodity String
  tons      Float
  /** Instant où le camion se pose dans la cour. */
  arrivesAt DateTime
  /** Passé cette date, la caisse se range seule : rien ne se perd. */
  autoAt    DateTime
  /** Case de la parcelle où la caisse est posée. */
  parcelId  String
  x         Int
  y         Int
  createdAt DateTime @default(now())

  @@index([farmId, arrivesAt])
}

/**
 * Un lot de jeunes bêtes, et la date où il passe adulte.
 *
 * Un lot plutôt qu'un compteur sur le troupeau : deux achats faits à dix
 * minutes d'intervalle ne mûrissent pas ensemble, et un compteur unique
 * obligerait à choisir une date pour les deux — donc à mentir sur l'une.
 *
 * Les jeunes sont comptés dans `Herd.size` : ils occupent une place à
 * l'étable et ils mangent. Ce qui les distingue, c'est qu'ils ne produisent
 * rien et qu'ils mangent moins.
 */
model YoungBatch {
  id        String   @id @default(cuid())
  herdId    String
  herd      Herd     @relation(fields: [herdId], references: [id], onDelete: Cascade)
  count     Int
  /** Instant où ce lot rejoint les adultes. */
  maturesAt DateTime
  createdAt DateTime @default(now())

  @@index([herdId, maturesAt])
}

model Zone {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  country       String
  koppen        String
  riskNote      String
  mapW          Int      @default(4)
  mapH          Int      @default(3)
  continentCode String   @default("AUR")
  continentName String   @default("Auralie")
  city          String   @default("")
  climateLabel  String   @default("")
  hemisphere    String   @default("N")
  lat           Float    @default(0)
  lon           Float    @default(0)
  priceMult     Float    @default(1)
  baseFertility Float    @default(0.7)
  parcels       Parcel[]
}

model Parcel {
  id         String     @id @default(cuid())
  zoneId     String
  zone       Zone       @relation(fields: [zoneId], references: [id])
  farmId     String?
  farm       Farm?      @relation(fields: [farmId], references: [id])
  label      String
  mapX       Int
  mapY       Int
  gridW      Int        @default(12)
  gridH      Int        @default(12)
  landPrice   Float
  fertility   Float     @default(0.7)
  accessIndex Float     @default(0.5)
  /// Quand cette parcelle est entrée dans la ferme qui la détient.
  ///
  /// Elle existe pour une seule raison : donner à la liste des parcelles un
  /// **ordre qui ne bouge pas**. Sans clé de tri, PostgreSQL rend les lignes
  /// dans l'ordre du tas, et le moindre `UPDATE` sur une parcelle — la
  /// fertilité change à chaque semis, labour, épandage et moisson — la renvoie
  /// en fin de liste. Le joueur voyait donc ses parcelles « bouger » toutes
  /// seules d'une session à l'autre.
  ///
  /// Nulle pour les parcelles acquises avant que cette colonne existe : la
  /// migration en retrouve autant que le journal comptable en garde trace, et
  /// le tri place les indatables en tête, par identifiant, ce qui reste stable
  /// à défaut d'être exact.
  acquiredAt  DateTime?
  cells      ParcelCell[]
  buildings  Building[]
  machines   Machine[]  @relation("ParkedOn")
  laborOrders LaborOrder[]

  @@unique([zoneId, mapX, mapY])
  fieldJobs     FieldJob[]
}

model ParcelCell {
  id               String     @id @default(cuid())
  parcelId         String
  parcel           Parcel     @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  x                Int
  y                Int
  kind             CellKind   @default(EMPTY)
  buildingId       String?
  building         Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  machineId        String?    @unique
  machine          Machine?   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  crop             CropCode?
  fieldStage       FieldStage @default(EMPTY)
  plantedAt        DateTime?
  readyAt          DateTime?
  fertilizedPasses Int        @default(0)
  /**
   * Pression d'adventices, 0 à 1.
   *
   * Remplace un booléen `weedsControlled` qui valait dix pour cent de
   * rendement et ne passait à vrai qu'en même temps que la fertilisation, sans
   * qu'aucun geste du joueur ne puisse le déclencher. Un booléen ne repousse
   * pas ; les adventices, si.
   */
  weedPressure     Float    @default(0)
  /**
   * Depuis quand cette pression court.
   *
   * Les adventices lèvent avec le temps ; sans date de référence, la pression
   * serait figée et le désherbage n'aurait rien à combattre. On l'intègre à la
   * lecture plutôt que de la faire monter par un tick, exactement comme la
   * croissance — une valeur dérivée ne peut pas se désynchroniser.
   */
  weedAt           DateTime?
  /// Récoltes depuis le dernier labour ; à 3, la charrue devient obligatoire
  harvestsSincePlow Int       @default(0)
  /// Déchaumages consécutifs : les résidus incorporés bonifient le rendement
  residuePasses    Int        @default(0)
  /// Chaumes en place après moisson : il faut travailler le sol avant de semer
  hasStubble       Boolean    @default(false)
  /// Semé dans les chaumes, sans travail du sol : rendement moindre
  directSeeded     Boolean    @default(false)
  /// Culture semée au cycle précédent, pour l'effet de rotation
  lastCrop         CropCode?
  /// Cycles consécutifs de cette même culture ; deux blés d'affilée se paient
  cropStreak       Int        @default(0)
  strawTons        Float      @default(0)
  baleCount        Int        @default(0)
  plantedAsSilage  Boolean    @default(false)

  @@unique([parcelId, x, y])
}

/// Un troupeau vit dans une étable. Son bonheur dépend de l'accès à un
/// enclos adjacent, et conditionne lait et viande.
model Herd {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  buildingId    String   @unique
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  kind          String   @default("COW")
  size          Int      @default(0)
  /// Satisfaction des besoins, de 0 à 1. **Un** par défaut : un troupeau
  /// qu'on vient d'acheter et qu'on nourrit ne manque de rien. Le 0,6 d'avant
  /// venait de l'ancienne échelle, où la cible d'une bête enfermée plafonnait
  /// à 0,35 et où 0,6 se lisait « Sereines ».
  happiness     Float    @default(1)
  bornAt        DateTime @default(now())
  lastGrazedAt  DateTime?
  lastTickAt    DateTime @default(now())
  lastMilkedAt  DateTime?
  grazingUntil  DateTime?
  /// Dernier repas distribué ; sans ration, le troupeau dépérit
  lastFedAt     DateTime?
  /// Qualité de la dernière ration, 0 = fourrage seul, 1 = maïs
  feedQuality   Float     @default(0)
  /// Réserve d'aliment déjà distribuée, en unités nutritives
  feedStock     Float     @default(0)
  /// Début de la gestation en cours ; null si aucune
  gestatingSince DateTime?
  /// Dernière mise bas
  lastCalvedAt  DateTime?
  /// Âge moyen du lot, dilué à chaque naissance ou achat
  avgAgeMs      Float     @default(0)
  /// Pertes fractionnaires reportées : sans elles, un petit lot ne meurt jamais
  mortalityDebt Float     @default(0)
  /// Où vit le lot, durablement : INSIDE ou OUTSIDE. Ce n'est plus une
  /// séance minutée mais un état que le joueur choisit et qui persiste.
  housing       String    @default("INSIDE")
  /// Herbe sur pied dans l'enclos, en tonnes. Elle pousse selon la saison et
  /// se broute : c'est elle qui nourrit vraiment les bêtes sorties.
  grassTons     Float     @default(0)
  /// Fosse à fumier, en tonnes — reste au bâtiment, pas au silo
  manureTons    Float     @default(0)
  /// Paille en litière, en tonnes — le pont aller depuis le céréalier
  beddingTons   Float     @default(0)
  /// Abreuvement, de 0 à 1. Plein tant qu'on passe distribuer la ration, ou
  /// en permanence si un abreuvoir automatique est rattaché au bâtiment.
  water         Float     @default(1)
  /// Santé du lot, de 0 à 1. **La seule jauge qui peut tuer**, et elle ne
  /// baisse que par la cascade : huit heures réelles de sursis après le
  /// manque, puis vingt-huit heures de dégradation avant la première perte.
  health        Float     @default(1)
  /// Depuis quand un besoin vital n'est plus couvert ; null si tout va bien.
  /// C'est l'horloge de la cascade, et elle se remet à zéro dès qu'on nourrit.
  deprivedSince DateTime?
  /// Lots de jeunes en croissance ; ils comptent dans `size`
  youngBatches  YoungBatch[]
}

model Building {
  id        String       @id @default(cuid())
  parcelId  String
  parcel    Parcel       @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  type      BuildingType
  level     Int          @default(1)
  originX   Int
  originY   Int
  /// Quarts de tour, 0 à 3. Façade au sud au repos ; un quart impair permute
  /// largeur et profondeur de l'emprise — voir `orientedFootprint`.
  rotation  Int          @default(0)
  /// Date de pose : elle ouvre la fenêtre de regret, pendant laquelle une
  /// construction faite par erreur se démolit intégralement remboursée.
  createdAt DateTime     @default(now())
  /// Dernier arrêté de transformation, pour les ateliers. La production se
  /// calcule sur le temps écoulé depuis cette date : sans elle, un atelier
  /// produirait au rythme des connexions du joueur.
  processedAt DateTime?
  cells     ParcelCell[]
  storedMachines Machine[] @relation("StoredIn")
  herd      Herd?
}

model InventoryItem {
  id       String @id @default(cuid())
  farmId   String
  farm     Farm   @relation(fields: [farmId], references: [id])
  itemCode String
  qty      Float
  quality  Int    @default(3)
  /** Humidité grain 0–1 (ex. 0.14 = 14 %) */
  moisture Float  @default(0)
  /// Dernier passage de la péremption sur ce lot
  lastDecayAt DateTime @default(now())
}

model Machine {
  id                 String      @id @default(cuid())
  farmId             String
  farm               Farm        @relation(fields: [farmId], references: [id])
  type               String
  tier               Int         @default(1)
  condition          Float       @default(100)
  /**
   * Compteur horaire. Monotone : il ne recule pas, pas même après une
   * révision. `condition` dit l'entretien, `hours` dit l'âge — et c'est l'âge
   * qui fixe la cote à la revente.
   */
  hours              Float       @default(0)
  /**
   * Occupée jusqu'à cette heure par un chantier en cours. Un engin au champ ne
   * peut ni repartir sur un autre travail, ni se vendre.
   */
  busyUntil          DateTime?
  /** Encore vrai si la jauge n’est pas vide — dérivé de `grease`. */
  greased            Boolean     @default(true)
  /** Jauge 0–100. Un champ entier n’en consomme qu’une partie. */
  grease             Float       @default(100)
  /** 0–100, la boue du champ. Plus elle monte, plus l'usure grimpe. */
  dirt               Float       @default(0)
  /** Départs à sec d’affilée. À 1, le suivant est refusé. */
  greaseSkipStreak   Int         @default(0)
  /** BELT, HYDRAULIC, ENGINE — null si ça roule */
  breakdown          String?
  parkedParcelId     String?
  parkedParcel       Parcel?     @relation("ParkedOn", fields: [parkedParcelId], references: [id])
  storedInBuildingId String?
  storedInBuilding   Building?   @relation("StoredIn", fields: [storedInBuildingId], references: [id])
  cell               ParcelCell?
}

/**
 * Une machine d'occasion en vente entre joueurs.
 *
 * L'engin quitte réellement la ferme quand on le met en vente : la ligne
 * ci-dessous *est* la machine pendant l'annonce. C'est ce qui empêche de
 * continuer à labourer avec un tracteur qu'on est en train de vendre, et ce
 * qui garantit qu'un seul exemplaire existe à tout instant.
 *
 * L'état voyage avec la machine — compteur, condition, graisse, saleté. Un
 * acheteur reprend l'engin tel quel, ce qui donne son sens au prix affiché.
 */
model MachineListing {
  id          String    @id @default(cuid())
  sellerId    String
  seller      User      @relation("SellingMachines", fields: [sellerId], references: [id], onDelete: Cascade)
  type        String
  tier        Int       @default(1)
  hours       Float     @default(0)
  condition   Float     @default(100)
  grease      Float     @default(100)
  dirt        Float     @default(0)
  breakdown   String?
  priceCrd    Float
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  buyerId     String?
  buyer       User?     @relation("BuyingMachines", fields: [buyerId], references: [id])
  soldAt      DateTime?

  @@index([status, type])
}

/**
 * Un chantier en cours.
 *
 * Les travaux étaient instantanés : on cliquait, le champ était labouré. Ça
 * tenait tant que rien ne disait combien de temps ça prend — mais depuis que
 * les heures sont réelles, un labour de quatorze hectares demande onze heures
 * de tracteur et un épandage une seule. Les faire tenir dans le même clic
 * effaçait exactement ce que la largeur de travail venait d'apporter.
 *
 * Le chantier réserve : ses cases ne peuvent pas être reprises par un autre
 * travail, et son attelage est immobilisé jusqu'à `endsAt`. Le travail lui-même
 * s'exécute à l'échéance, par la route habituelle — c'est ce qui évite de
 * dupliquer mille lignes d'effets agronomiques dans un second chemin qui
 * finirait par diverger du premier.
 */
model FieldJob {
  id        String   @id @default(cuid())
  parcelId  String
  parcel    Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  userId    String
  work      String
  /** Cases réservées, au même format que les ordres de chantier. */
  cellsJson String
  /** Culture à semer, pour un chantier de semis. */
  crop      String?
  machineId String
  tractorId String?
  /** Gazole engagé au départ ; rendu si le chantier est abandonné. */
  fuelL     Float    @default(0)
  startedAt DateTime @default(now())
  endsAt    DateTime
  /** RUNNING · DONE · CANCELLED */
  status    String   @default("RUNNING")

  @@index([parcelId, status])
  @@index([userId, status])
}

model MarketPrice {
  id        String   @id @default(cuid())
  /// Code marchandise libre : cultures, mais aussi lait, viande et fourrage
  commodity String   @unique
  price     Float
  stockTons Float    @default(1000)
  updatedAt DateTime @updatedAt
}

/// Un engagement à livrer plus tard, à un prix fixé aujourd'hui.
model FuturesContract {
  id           String   @id @default(cuid())
  sellerId     String
  seller       User     @relation("Futures", fields: [sellerId], references: [id], onDelete: Cascade)
  commodity    String
  tons         Float
  pricePerTon  Float
  createdAt    DateTime @default(now())
  dueAt        DateTime
  /// OPEN, SETTLED ou DEFAULTED
  status       String   @default("OPEN")
  settledAt    DateTime?
  /// Cours au moment du dénouement, pour dire au joueur si son pari valait
  marketAtDue  Float?

  @@index([sellerId, status])
  @@index([status, dueAt])
}

/// Un relevé de cours. Sans mémoire des prix, le joueur ne peut ni juger si
/// l'offre du jour est bonne, ni décider d'attendre : il vend au hasard.
model MarketTick {
  id        String   @id @default(cuid())
  commodity String
  price     Float
  at        DateTime @default(now())

  @@index([commodity, at])
}

/// Une annonce à la criée : un lot mis en vente par un joueur, qu'un autre
/// joueur peut acheter tant qu'elle n'a pas expiré.
model MarketListing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation("Selling", fields: [sellerId], references: [id], onDelete: Cascade)
  commodity   String
  tons        Float
  pricePerTon Float
  /// Humidité du lot : elle suit la marchandise jusque chez l'acheteur
  moisture    Float    @default(0.12)
  quality     Int      @default(3)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  buyerId     String?
  buyer       User?    @relation("Buying", fields: [buyerId], references: [id])
  soldAt      DateTime?

  @@index([status, commodity])
}

/// Achat à la criée : l'argent a changé de main, la marchandise est encore en route.
/**
 * Le journal des mouvements d'argent.
 *
 * Le jeu ne conservait qu'un solde, `User.crd`. Aucune écriture ne disait d'où
 * venait un TRN ni où il était parti : le lait vendu, la révision payée, le
 * chantier encaissé et la parcelle achetée se fondaient dans un même nombre.
 * Le Bureau ne pouvait donc pas répondre à sa propre question — « comment se
 * porte mon activité ? » — faute de la moindre donnée.
 *
 * Une ligne par mouvement, écrite dans la transaction qui bouge le solde :
 * il n'y a rien à recalculer, donc rien qui puisse se désynchroniser. Le
 * montant est signé — négatif pour une sortie — pour qu'une somme donne
 * directement le résultat.
 */
model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Montant signé : positif en recette, négatif en dépense. */
  amount    Float
  /** Poste comptable — voir `LEDGER_POSTES` côté domaine. */
  poste     String
  /** De quoi il s'agit, en clair : « Blé, 12 t » ou « Révision moissonneuse ». */
  label     String
  at        DateTime @default(now())

  @@index([userId, at])
}

model Delivery {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation("DeliverySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("DeliveryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerFarmId String
  listingId   String?
  commodity   String
  tons        Float
  moisture    Float    @default(0.12)
  quality     Int      @default(3)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  dueAt       DateTime
  autoFee     Float
  deliveredAt DateTime?

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, dueAt])
}

model NpcContract {
  id          String          @id @default(cuid())
  jobType     ContractJobType
  title       String
  rewardCrd   Float
  regionNote  String
  /// Cases du chantier (8–24). L'usure et le salaire suivent ce chiffre.
  cells       Int             @default(16)
  status      ContractStatus  @default(OPEN)
  providerId  String?
  provider    User?           @relation("Provider", fields: [providerId], references: [id])
  createdAt   DateTime        @default(now())
  completedAt DateTime?
}

/// Chantier P2P : le client escrowe le devis, le prestataire travaille SA parcelle.
model LaborOrder {
  id            String         @id @default(cuid())
  parcelId      String
  parcel        Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  clientId      String
  client        User           @relation("LaborClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId    String?
  provider      User?          @relation("LaborProvider", fields: [providerId], references: [id])
  work          String
  crop          String?
  cellsJson     String
  remainingJson String
  quoteCrd      Float
  extrasCrd     Float
  escrowCrd     Float
  payoutCrd     Float
  status        ContractStatus @default(OPEN)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  completedAt   DateTime?

  @@index([status, createdAt])
  @@index([providerId, status])
  @@index([parcelId, status])
}

model WeatherSnapshot {
  id        String   @id @default(cuid())
  zoneCode  String
  state     String
  updatedAt DateTime @updatedAt
}
