generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Specialization {
  CEREALIER
  ELEVEUR
  ETA
}

enum CropCode {
  WHEAT
  MAIZE
}

enum FieldStage {
  EMPTY
  PREPARED
  PLANTED
  GROWING
  READY
  HARVESTED
}

enum ContractJobType {
  PLOW
  SOW
  FERTILIZE
  HARVEST
  TRANSPORT
}

enum ContractStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum BuildingType {
  SILO
  HAY_BARN
  MACHINE_SHED
  CATTLE_BARN
  PIGSTY
  WORKSHOP
  FARMHOUSE
}

enum CellKind {
  EMPTY
  CROP
  BUILDING
  VEHICLE
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  displayName    String
  specialization Specialization
  level          Int            @default(1)
  xp             Int            @default(0)
  crd            Float          @default(12000)
  /** Code d’accès MVP (pas un vrai hash — démo locale) */
  accessCode     String         @default("ferme")
  lastSeenAt     DateTime?
  lastMarketJson String?
  createdAt      DateTime       @default(now())
  farm           Farm?
  contracts      NpcContract[]  @relation("Provider")
  sessions       Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Farm {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id])
  name      String
  parcels   Parcel[]
  inventory InventoryItem[]
  machines  Machine[]
}

model Zone {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  country  String
  koppen   String
  riskNote String
  mapW     Int      @default(4)
  mapH     Int      @default(3)
  parcels  Parcel[]
}

model Parcel {
  id         String     @id @default(cuid())
  zoneId     String
  zone       Zone       @relation(fields: [zoneId], references: [id])
  farmId     String?
  farm       Farm?      @relation(fields: [farmId], references: [id])
  label      String
  mapX       Int
  mapY       Int
  gridW      Int        @default(12)
  gridH      Int        @default(12)
  landPrice  Float
  fertility  Float      @default(0.7)
  cells      ParcelCell[]
  buildings  Building[]
  machines   Machine[]  @relation("ParkedOn")

  @@unique([zoneId, mapX, mapY])
}

model ParcelCell {
  id               String     @id @default(cuid())
  parcelId         String
  parcel           Parcel     @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  x                Int
  y                Int
  kind             CellKind   @default(EMPTY)
  buildingId       String?
  building         Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  machineId        String?    @unique
  machine          Machine?   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  crop             CropCode?
  fieldStage       FieldStage @default(EMPTY)
  plantedAt        DateTime?
  readyAt          DateTime?
  fertilizedPasses Int        @default(0)
  weedsControlled  Boolean    @default(false)

  @@unique([parcelId, x, y])
}

model Building {
  id        String       @id @default(cuid())
  parcelId  String
  parcel    Parcel       @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  type      BuildingType
  originX   Int
  originY   Int
  cells     ParcelCell[]
  storedMachines Machine[] @relation("StoredIn")
}

model InventoryItem {
  id       String @id @default(cuid())
  farmId   String
  farm     Farm   @relation(fields: [farmId], references: [id])
  itemCode String
  qty      Float
  quality  Int    @default(3)
  /** Humidité grain 0–1 (ex. 0.14 = 14 %) */
  moisture Float  @default(0)
}

model Machine {
  id                 String      @id @default(cuid())
  farmId             String
  farm               Farm        @relation(fields: [farmId], references: [id])
  type               String
  tier               Int         @default(1)
  condition          Float       @default(100)
  parkedParcelId     String?
  parkedParcel       Parcel?     @relation("ParkedOn", fields: [parkedParcelId], references: [id])
  storedInBuildingId String?
  storedInBuilding   Building?   @relation("StoredIn", fields: [storedInBuildingId], references: [id])
  cell               ParcelCell?
}

model MarketPrice {
  id        String   @id @default(cuid())
  commodity CropCode @unique
  price     Float
  stockTons Float    @default(1000)
  updatedAt DateTime @updatedAt
}

model NpcContract {
  id          String          @id @default(cuid())
  jobType     ContractJobType
  title       String
  rewardCrd   Float
  regionNote  String
  status      ContractStatus  @default(OPEN)
  providerId  String?
  provider    User?           @relation("Provider", fields: [providerId], references: [id])
  createdAt   DateTime        @default(now())
  completedAt DateTime?
}

model WeatherSnapshot {
  id        String   @id @default(cuid())
  zoneCode  String
  state     String
  updatedAt DateTime @updatedAt
}
